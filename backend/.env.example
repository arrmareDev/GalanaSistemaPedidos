APP_NAME="Galana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=galana_dev
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# WhatsApp del negocio (código de país, sin +)
WA_PHONE=51999999999

# Ubicación del local y radio máximo de delivery
LOCAL_LAT=-6.7714
LOCAL_LNG=-79.8409
LOCAL_RADIO_MAX_KM=25

# Integración con DeliveryCentral (dejar vacío si no se usa)
DELIVERY_CENTRAL_URL=
DELIVERY_CENTRAL_API_KEY=
DELIVERY_CENTRAL_WEBHOOK_SECRET=

# Notificaciones push: generar con "php artisan webpush:vapid"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@galana.pe

# Tiempo real (Reverb), solo si BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
